{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name created in the Cloudflare dashboard (Workers Builds).
  "name": "herraga-landing",
  "compatibility_date": "2026-10-07",
  // Static Astro build (npm run build -> dist/). No routes or custom domains here:
  // domains are managed in the dashboard so a deploy never takes or drops a hostname.
  "assets": {
    "directory": "./dist"
  }
}
