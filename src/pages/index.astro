---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Engines from '../components/Engines.astro';
import Pillars from '../components/Pillars.astro';
import Products from '../components/Products.astro';
import Brands from '../components/Brands.astro';
import Branches from '../components/Branches.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
import ContactWidget from '../components/ContactWidget.astro';

const title = 'Refacciones Diésel para Motores de Rango Pesado | HERRAGA';
const description =
  'Refacciones diésel originales: medias reparaciones y cabezas de cilindro Cummins, Detroit, Volvo y más. Envíos a todo México.';
---

<Layout title={title} description={description}>
  <Header />
  <main id="contenido">
    <Hero />
    <Engines />
    <Pillars />
    <Branches />
    <Products />
    <Brands />
    <Quote />
  </main>
  <Footer />
  <ContactWidget />
</Layout>
