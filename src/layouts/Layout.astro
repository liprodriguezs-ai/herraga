---
import '@fontsource-variable/big-shoulders-display/wght';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/global.css';
// Fonts used in the first viewport, preloaded so text does not reflow (and shift the CTAs) when they arrive.
import fontDisplay from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import fontBody from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import fontLabel600 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url';
import fontLabel700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
const criticalFonts = [fontDisplay, fontBody, fontLabel600, fontLabel700];
import {
  SITE_URL,
  GTM_ID,
  company,
  NATIONAL_PHONE,
  SERVICE_PHONE,
  branches,
  social,
  specialties,
  products,
} from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Social previews (Google, X, LinkedIn, WhatsApp) truncate longer copy; fail the build instead of shipping it.
const MAX_TITLE = 60;
const MAX_DESCRIPTION = 125;
if (title.length > MAX_TITLE) {
  throw new Error(`Title is ${title.length} characters (max ${MAX_TITLE}): "${title}"`);
}
if (description.length > MAX_DESCRIPTION) {
  throw new Error(`Description is ${description.length} characters (max ${MAX_DESCRIPTION}): "${description}"`);
}

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
// Source: scripts/og/og.html. Rename the file on every redesign so social networks drop their cached copy.
const ogImage = new URL('/og-herraga-2026-10.jpg', SITE_URL).href;

const orgId = `${SITE_URL}/#organization`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: company.brand,
      legalName: company.legalName,
      url: SITE_URL,
      logo: `${SITE_URL}/icon-512.png`,
      slogan: company.tagline,
      description: company.description,
      telephone: `+52${NATIONAL_PHONE}`,
      areaServed: { '@type': 'Country', name: 'México' },
      sameAs: social.map((s) => s.href),
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: `+52${NATIONAL_PHONE}`,
          contactType: 'sales',
          areaServed: 'MX',
          availableLanguage: 'es',
        },
        {
          '@type': 'ContactPoint',
          telephone: `+52${SERVICE_PHONE}`,
          contactType: 'customer service',
          areaServed: 'MX',
          availableLanguage: 'es',
        },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Refacciones diésel para motores de rango medio y pesado',
        itemListElement: [
          ...specialties.map((s) => ({
            '@type': 'OfferCatalog',
            name: s.title,
            itemListElement: s.groups.map((g) => ({
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Product',
                name: `${s.title} ${g.brand} ${g.lines.flat().join(', ')}`,
                brand: g.brand,
              },
            })),
          })),
          ...products.map((p) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Product', name: p.title, description: p.body },
          })),
        ],
      },
      department: branches.map((b) => ({
        '@type': 'AutoPartsStore',
        name: `${company.brand} ${b.city}`,
        telephone: `+52${b.phone}`,
        image: ogImage,
        parentOrganization: { '@id': orgId },
        address: {
          '@type': 'PostalAddress',
          addressLocality: b.city,
          addressRegion: b.regionCode,
          addressCountry: 'MX',
        },
      })),
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: company.brand,
      inLanguage: 'es-MX',
      publisher: { '@id': orgId },
    },
  ],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ gtmId: GTM_ID }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>
    <!-- End Google Tag Manager -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={company.legalName} />
    <meta name="theme-color" content="#08303f" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="MX" />

    {criticalFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={company.brand} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HERRAGA Refacciones: la fuerza detrás de tu motor. Cotiza por WhatsApp." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@herraga_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Fragment set:html={`<!--
THESIS: HERRAGA's landing is the front of a Mexican tractocamión, not a parts-store template; it refuses the stock dark hero + truck photo + icon-card grid.
OWN-WORLD: cab-paint navy, polished chrome trim lettering, amber clearance lights, HERRAGA red, black mud-flap rubber with riveted chrome engine tags, hand-painted filete pinstripes; Big Shoulders Display + highway-sign Barlow.
STORY: the buyer sees their engine brand and model, believes HERRAGA has the original part, and opens WhatsApp with the engine already written in the message.
FIRST VIEWPORT: roof lights switch on across the top, chrome nameplate headline over the cab photo from the original banner in a navy duotone, red WhatsApp action left under it, bumper bar of brands at the bottom.
FORM: candidate 6 of 7 (Mexican truck decoration: loderas y cromo); seed key c54f5711.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`} />
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      import { trackContactLinks } from '../lib/track';
      trackContactLinks();
    </script>
  </body>
</html>
