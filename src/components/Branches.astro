---
import Icon from './Icon.astro';
import BranchMap from './BranchMap.astro';
import { branches, guarantees, NATIONAL_PHONE, SERVICE_PHONE, formatPhone, telHref, whatsappHref } from '../data/site';

const guaranteeIcons = ['shield', 'gear', 'award', 'truck'];
---

<section id="sucursales" class="branches" aria-labelledby="sucursales-title">
  <div class="wrap grid">
    <div class="intro">
      <h2 id="sucursales-title" class="section-title">Nuestras sucursales</h2>
      <p class="section-lede">
        Soluciones en refacciones diésel para que tu motor nunca se detenga. Disponibilidad inmediata en
        múltiples sucursales.
      </p>
      <BranchMap />
    </div>

    <div class="list-wrap">
      <ul class="list">
        {branches.map((b) => (
          <li>
            <a class="branch" href={telHref(b.phone)} aria-label={`Llamar a sucursal ${b.city}, ${formatPhone(b.phone)}`}>
              <span class="place">
                <span class="city">{b.city}</span>
                <span class="region">{b.region}</span>
              </span>
              <span class="number">{formatPhone(b.phone)}</span>
              <span class="dial" aria-hidden="true"><Icon name="phone" /></span>
            </a>
          </li>
        ))}
      </ul>

      <div class="lines">
        <div class="line line--main">
          <p class="line-label">Atención nacional</p>
          <a class="line-number" href={telHref(NATIONAL_PHONE)}>{formatPhone(NATIONAL_PHONE)}</a>
          <div class="line-actions">
            <a class="btn btn--primary btn--sm" href={whatsappHref()} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              WhatsApp
            </a>
            <a class="dial dial--btn" href={telHref(NATIONAL_PHONE)} aria-label={`Llamar a atención nacional, ${formatPhone(NATIONAL_PHONE)}`}>
              <Icon name="phone" />
            </a>
          </div>
        </div>
        <div class="line">
          <p class="line-label">Servicio a clientes</p>
          <a class="line-number" href={telHref(SERVICE_PHONE)}>{formatPhone(SERVICE_PHONE)}</a>
          <div class="line-actions">
            <a class="call-link" href={telHref(SERVICE_PHONE)} aria-label={`Llamar a servicio a clientes, ${formatPhone(SERVICE_PHONE)}`}>
              <Icon name="phone" />
              Llamar
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="strip">
    <div class="wrap strip-inner">
      <ul class="guarantees">
        {guarantees.map((g, i) => (
          <li>
            <Icon name={guaranteeIcons[i]} />
            {g}
          </li>
        ))}
      </ul>
      <p class="motto">Refacciones diésel de calidad, donde y cuando las necesitas.</p>
    </div>
  </div>
</section>

<style>
  .branches {
    padding-top: var(--space-xl);
    background: var(--white);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-l);
    align-items: start;
  }


  .list-wrap {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    border-radius: 14px;
    background: var(--cab-deep);
    color: var(--white);
    box-shadow: 0 0 0 4px #c9d2d7, 0 0 0 6px #5c6a71, 0 30px 60px -30px rgb(4 29 39 / 0.8);
  }

  /* Each branch is one tappable row: place on the left, the number as the hero, a quiet dial on the right. */
  .list {
    display: grid;
  }
  .list li + li {
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .branch {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0.6rem;
    border-radius: 8px;
    color: var(--white);
    text-decoration: none;
    transition: background-color 160ms;
  }
  .branch:hover,
  .branch:focus-visible {
    background: rgb(255 255 255 / 0.05);
  }
  .place {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .city {
    font-family: var(--font-label);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.1;
  }
  .region {
    font-size: 0.95rem;
    color: #9fb0b8;
  }
  .number {
    font-family: var(--font-label);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* Quiet circular dial; lights up amber on hover/focus of its row. */
  .dial {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
    color: var(--amber);
    transition:
      background-color 160ms,
      color 160ms,
      box-shadow 160ms;
  }
  .dial :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .branch:hover .dial,
  .branch:focus-visible .dial,
  .dial--btn:hover,
  .dial--btn:focus-visible {
    background: var(--amber);
    box-shadow: none;
    color: var(--cab-deep);
  }

  .lines {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .line {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1rem 1.1rem 1.1rem;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 3px 0 rgb(255 255 255 / 0.18);
  }
  .line--main {
    box-shadow: inset 0 3px 0 var(--red);
  }
  .line-label {
    font-family: var(--font-label);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9fb0b8;
  }
  .line-number {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1vw, 2rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--white);
    text-decoration: none;
  }
  .line-number:hover {
    text-decoration: underline;
  }
  .line-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }
  .call-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.6rem;
    font-family: var(--font-label);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
    text-decoration: none;
  }
  .call-link:hover {
    color: var(--amber-hot);
    text-decoration: underline;
  }
  .call-link :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .strip {
    margin-top: var(--space-xl);
    background: var(--cab);
    color: var(--white);
  }
  .strip-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: stretch;
  }
  .guarantees {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 1.5rem;
  }
  .guarantees li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-label);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.15;
    text-transform: uppercase;
  }
  .guarantees :global(svg) {
    flex: none;
    width: 2rem;
    height: 2rem;
    color: var(--red-bright);
  }
  .motto {
    display: grid;
    place-items: center start;
    padding: 1.5rem 1.5rem 1.5rem 3rem;
    background: var(--red);
    clip-path: polygon(1.5rem 0, 100% 0, 100% 100%, 0 100%);
    font-family: var(--font-label);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .strip-inner {
      grid-template-columns: 1fr;
      width: 100%;
    }
    .guarantees {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: var(--wrap);
      margin-inline: auto;
    }
    .motto {
      clip-path: none;
      padding: 1.25rem clamp(1rem, 4vw, 2.5rem);
    }
  }
  @media (max-width: 560px) {
    .lines {
      grid-template-columns: 1fr;
    }
    .branch {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0.15rem;
    }
    .number {
      grid-column: 1;
      grid-row: 2;
      font-size: 1.2rem;
      color: var(--amber);
    }
    .branch .dial {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
