---
import Icon from './Icon.astro';
import BranchMap from './BranchMap.astro';
import { branches, guarantees, NATIONAL_PHONE, SERVICE_PHONE, formatPhone, telHref, whatsappHref } from '../data/site';

const guaranteeIcons = ['shield', 'gear', 'award', 'truck'];
---

<section id="sucursales" class="branches" aria-labelledby="sucursales-title">
  <div class="wrap grid">
    <div class="intro">
      <h2 id="sucursales-title" class="section-title">Nuestras sucursales</h2>
      <p class="section-lede">
        Soluciones en refacciones diésel para que tu motor nunca se detenga. Disponibilidad inmediata en
        múltiples sucursales.
      </p>
      <BranchMap />
    </div>

    <div class="list-wrap">
      <ul class="list">
        {branches.map((b) => (
          <li class="branch">
            <span class="badge" aria-hidden="true"><Icon name="store" /></span>
            <div class="who">
              <h3>{b.city}<span>, {b.region}</span></h3>
              <a class="number" href={telHref(b.phone)}>{formatPhone(b.phone)}</a>
            </div>
            <a class="call" href={telHref(b.phone)} aria-label={`Llamar a sucursal ${b.city}, ${formatPhone(b.phone)}`}>
              <Icon name="phone" />
              Llamar
            </a>
          </li>
        ))}
      </ul>

      <div class="lines">
        <div class="line">
          <span class="badge" aria-hidden="true"><Icon name="whatsapp" /></span>
          <div class="who">
            <h3>Atención nacional</h3>
            <a class="number big" href={telHref(NATIONAL_PHONE)}>{formatPhone(NATIONAL_PHONE)}</a>
          </div>
          <div class="actions">
            <a class="btn btn--primary btn--sm" href={whatsappHref()} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              WhatsApp
            </a>
            <a class="call" href={telHref(NATIONAL_PHONE)} aria-label={`Llamar a atención nacional, ${formatPhone(NATIONAL_PHONE)}`}>
              <Icon name="phone" />
              Llamar
            </a>
          </div>
        </div>
        <div class="line line--dark">
          <span class="badge badge--dark" aria-hidden="true"><Icon name="headset" /></span>
          <div class="who">
            <h3>Servicio a clientes</h3>
            <a class="number big" href={telHref(SERVICE_PHONE)}>{formatPhone(SERVICE_PHONE)}</a>
          </div>
          <div class="actions">
            <a class="call" href={telHref(SERVICE_PHONE)} aria-label={`Llamar a servicio a clientes, ${formatPhone(SERVICE_PHONE)}`}>
              <Icon name="phone" />
              Llamar
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="strip">
    <div class="wrap strip-inner">
      <ul class="guarantees">
        {guarantees.map((g, i) => (
          <li>
            <Icon name={guaranteeIcons[i]} />
            {g}
          </li>
        ))}
      </ul>
      <p class="motto">Refacciones diésel de calidad, donde y cuando las necesitas.</p>
    </div>
  </div>
</section>

<style>
  .branches {
    padding-top: var(--space-xl);
    background: var(--white);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-l);
    align-items: start;
  }


  .list-wrap {
    display: grid;
    gap: 1rem;
    padding: var(--space-m);
    border-radius: 14px;
    background: var(--cab-deep);
    color: var(--white);
    box-shadow: 0 0 0 4px #c9d2d7, 0 0 0 6px #5c6a71, 0 30px 60px -30px rgb(4 29 39 / 0.8);
  }
  .list {
    display: grid;
  }
  .branch,
  .line {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .who {
    flex: 1;
    min-width: 0;
  }
  .line .who {
    flex: 1 1 13rem;
  }
  .number {
    white-space: nowrap;
  }
  .branch {
    padding-block: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .badge {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--red);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), 0 0 0 3px rgb(255 255 255 / 0.12);
  }
  .badge :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  h3 {
    font-family: var(--font-label);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.15;
  }
  h3 span {
    color: #9fb0b8;
  }
  .number {
    display: inline-block;
    margin-top: 0.15rem;
    font-family: var(--font-label);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--amber);
    text-decoration: none;
  }
  .number:hover {
    color: var(--amber-hot);
    text-decoration: underline;
  }
  .number.big {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 900;
    letter-spacing: 0.02em;
    color: var(--white);
  }

  /* Call button: amber outline pill, 44px+ tap target. */
  .call {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 2px var(--amber);
    color: var(--amber);
    font-family: var(--font-label);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 160ms,
      color 160ms;
  }
  .call:hover,
  .call:focus-visible {
    background: var(--amber);
    color: var(--cab-deep);
  }
  .call :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .lines {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .line {
    flex-wrap: wrap;
    padding: 1rem;
    border-radius: 10px;
    background: var(--red);
  }
  .line--dark {
    background: rgb(255 255 255 / 0.06);
  }
  .line .badge {
    background: var(--white);
    color: var(--red);
  }
  .line .badge--dark {
    background: var(--red);
    color: var(--white);
  }
  .line h3 {
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-left: auto;
  }
  .line:not(.line--dark) .call {
    box-shadow: inset 0 0 0 2px var(--white);
    color: var(--white);
  }
  .line:not(.line--dark) .call:hover,
  .line:not(.line--dark) .call:focus-visible {
    background: var(--white);
    color: var(--red);
  }
  .line:not(.line--dark) .btn {
    --btn-bg: var(--white);
    --btn-fg: var(--red);
  }

  .strip {
    margin-top: var(--space-xl);
    background: var(--cab);
    color: var(--white);
  }
  .strip-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: stretch;
  }
  .guarantees {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 1.5rem;
  }
  .guarantees li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-label);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.15;
    text-transform: uppercase;
  }
  .guarantees :global(svg) {
    flex: none;
    width: 2rem;
    height: 2rem;
    color: var(--red-bright);
  }
  .motto {
    display: grid;
    place-items: center start;
    padding: 1.5rem 1.5rem 1.5rem 3rem;
    background: var(--red);
    clip-path: polygon(1.5rem 0, 100% 0, 100% 100%, 0 100%);
    font-family: var(--font-label);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .strip-inner {
      grid-template-columns: 1fr;
      width: 100%;
    }
    .guarantees {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: var(--wrap);
      margin-inline: auto;
    }
    .motto {
      clip-path: none;
      padding: 1.25rem clamp(1rem, 4vw, 2.5rem);
    }
  }
  @media (max-width: 480px) {
    .actions {
      width: 100%;
      margin-left: 0;
    }
    .actions > * {
      flex: 1;
      justify-content: center;
    }
  }
</style>
