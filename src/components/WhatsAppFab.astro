---
import Icon from './Icon.astro';
import { whatsappHref } from '../data/site';
---

<a class="fab" href={whatsappHref()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <Icon name="whatsapp" />
  <span class="label">¿Buscas una pieza?</span>
</a>

<style>
  .fab {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.6rem;
    padding: 0.5rem 1.2rem 0.5rem 0.9rem;
    border-radius: 999px;
    background: #1faa53;
    color: var(--white);
    font-family: var(--font-label);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.9), 0 14px 28px -10px rgb(0 0 0 / 0.55);
    transition: transform 200ms var(--ease-out);
  }
  .fab:hover {
    transform: translateY(-3px);
  }
  .fab :global(svg) {
    width: 1.9rem;
    height: 1.9rem;
  }
  @media (max-width: 640px) {
    .fab {
      padding: 0;
      width: 3.6rem;
      justify-content: center;
    }
    .label {
      display: none;
    }
  }
</style>
