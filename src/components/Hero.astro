---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoDark from '../assets/brand/logo-dark.png';
import { heroBrands, whatsappHref, company } from '../data/site';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="lights" aria-hidden="true">
    {Array.from({ length: 5 }).map((_, i) => <span class="light" style={`--i:${i}`} />)}
  </div>

  <div class="wrap cab">
    <div class="copy">
      <h1 id="hero-title">
        <span class="headline chrome">La fuerza detrás de tu motor</span>
        <span class="subline">Refacciones diésel para motores de rango pesado</span>
      </h1>

      <p class="claim">
        ¡Encuentra las mejores marcas! Refacciones originales y con garantía para unidades de rango medio y
        pesado, transporte de carga y pasajeros.
      </p>

      <ul class="specs">
        <li><Icon name="check" /> ¡Especialistas en medias reparaciones, cabezas de cilindro y más!</li>
        <li><Icon name="truck" /> Envíos a toda la república</li>
      </ul>

      <div class="ctas">
        <a class="btn btn--primary" href={whatsappHref()} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Cotiza por WhatsApp
        </a>
        <a class="btn btn--chrome" href="#motores">
          Busca tu motor
          <Icon name="arrow" />
        </a>
      </div>
    </div>

    <div class="grille" aria-hidden="true">
      <div class="slats"></div>
      <div class="emblem">
        <Image src={logoDark} alt="" width={260} height={170} loading="eager" />
        <span class="emblem-values">{company.values.join(' · ')}</span>
      </div>
    </div>
  </div>

  <div class="bumper">
    <div class="wrap">
      <h2 class="visually-hidden">Marcas con las que trabajamos</h2>
      <ul class="brand-row">
        {heroBrands.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 75% 10%, #0d4256 0%, transparent 60%),
      linear-gradient(180deg, var(--cab) 0%, var(--cab-deep) 100%);
    color: var(--white);
    isolation: isolate;
  }

  /* Five amber clearance lights on the cab roof. */
  .lights {
    display: flex;
    justify-content: center;
    gap: clamp(1.25rem, 5vw, 4.5rem);
    padding-block: 1.6rem 0.5rem;
  }
  .light {
    width: clamp(2.2rem, 4vw, 3.4rem);
    height: clamp(0.8rem, 1.3vw, 1.1rem);
    border-radius: 999px;
    background: radial-gradient(60% 90% at 50% 35%, var(--amber-hot), var(--amber) 55%, #b86d00 100%);
    box-shadow:
      0 0 0 2px #2b3a40,
      0 0 0 3px rgb(255 255 255 / 0.25),
      0 0 18px 4px rgb(255 178 46 / 0.55),
      0 6px 40px 10px rgb(255 178 46 / 0.25);
    animation: ignite 900ms var(--ease-out) both;
    animation-delay: calc(180ms + var(--i) * 110ms);
  }
  @keyframes ignite {
    0% {
      filter: brightness(0.25) saturate(0.4);
      box-shadow: 0 0 0 2px #2b3a40, 0 0 0 3px rgb(255 255 255 / 0.15);
    }
    35% {
      filter: brightness(1.6);
    }
    100% {
      filter: brightness(1);
    }
  }

  .cab {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--space-l);
    padding-block: var(--space-l) var(--space-xl);
  }

  h1 {
    display: grid;
    gap: 1.1rem;
  }
  .headline {
    display: block;
    font-size: var(--step-5);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.005em;
    background-size: 100% 100%;
    animation: glint 1400ms var(--ease-out) 900ms both;
  }
  @keyframes glint {
    from {
      background-image: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.95) 45%, transparent 60%), var(--chrome);
      background-size: 300% 100%, 100% 100%;
      background-position: 120% 0, 0 0;
    }
    to {
      background-image: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.95) 45%, transparent 60%), var(--chrome);
      background-size: 300% 100%, 100% 100%;
      background-position: -60% 0, 0 0;
    }
  }
  .subline {
    display: block;
    max-width: 26ch;
    font-family: var(--font-label);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.04em;
    color: var(--red-bright);
  }

  .claim {
    max-width: 52ch;
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.5;
    color: #c9d6dc;
  }

  .specs {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--space-m);
  }
  .specs li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-family: var(--font-label);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.3;
    color: var(--white);
  }
  .specs :global(svg) {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    padding: 0.15rem;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: var(--space-l);
  }

  /* Radiator grille: chrome surround, vertical slats, emblem mounted on top. */
  .grille {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 30rem;
    justify-self: end;
    padding: 14px;
    border-radius: 18px 18px 10px 10px;
    background: var(--chrome-h);
    box-shadow:
      inset 0 2px 0 rgb(255 255 255 / 0.7),
      0 30px 60px -30px rgb(0 0 0 / 0.9),
      0 12px 24px -12px rgb(0 0 0 / 0.6);
  }
  .slats {
    position: absolute;
    inset: 14px;
    border-radius: 10px 10px 4px 4px;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.45), transparent 22%, transparent 78%, rgb(0 0 0 / 0.55)),
      repeating-linear-gradient(
        90deg,
        #0a1114 0 7px,
        #8d99a0 7px 8px,
        #f2f6f8 8px 11px,
        #9aa6ad 11px 14px,
        #2a3439 14px 15px,
        #0a1114 15px 22px
      );
    box-shadow: inset 0 0 0 2px rgb(0 0 0 / 0.5), inset 0 20px 30px -10px rgb(0 0 0 / 0.6);
  }
  .emblem {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    width: 78%;
    padding: 1.2rem 1rem 1rem;
    transform: translate(-50%, -50%);
    border-radius: 10px;
    background: linear-gradient(180deg, #0b3647, var(--cab-deep));
    box-shadow:
      0 0 0 3px #c9d2d7,
      0 0 0 5px #5c6a71,
      0 18px 30px -12px rgb(0 0 0 / 0.85);
  }
  .emblem img {
    width: 100%;
    height: auto;
  }
  .emblem-values {
    font-family: var(--font-label);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--chrome-2);
  }

  /* Chrome bumper carrying the brands from the original banner. */
  .bumper {
    position: relative;
    background: var(--chrome-h);
    color: var(--cab-deep);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.8), inset 0 -3px 0 rgb(0 0 0 / 0.25);
  }
  .brand-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.75rem;
    padding-block: 1.05rem;
  }
  .brand-row li {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.7);
  }

  @media (max-width: 900px) {
    .cab {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-l);
    }
    .grille {
      order: -1;
      justify-self: stretch;
      max-width: none;
      aspect-ratio: auto;
      height: 11rem;
      margin-bottom: var(--space-s);
    }
    .emblem {
      width: auto;
      height: 76%;
      grid-auto-flow: column;
      align-items: center;
      padding: 0.6rem 1.2rem;
    }
    .emblem img {
      width: auto;
      height: 100%;
    }
    .emblem-values {
      display: none;
    }
    .brand-row {
      justify-content: center;
    }
  }

  @media (max-width: 520px) {
    .ctas .btn {
      flex: 1 1 100%;
    }
    .grille {
      height: 8.5rem;
    }
  }
</style>
