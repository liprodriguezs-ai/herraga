---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ChromeLetters from './ChromeLetters.astro';
import logoDark from '../assets/brand/logo-dark.png';
import { heroBrands, whatsappHref, company } from '../data/site';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="lights" aria-hidden="true">
    {Array.from({ length: 5 }).map((_, i) => <span class="light" style={`--i:${i}`} />)}
  </div>

  <div class="wrap cab">
    <div class="copy">
      <h1 id="hero-title">
        <span class="visually-hidden">La fuerza detrás de tu motor:</span>
        <ChromeLetters class="headline" lines={['LA FUERZA DETRÁS', 'DE TU MOTOR']} width={1040} size={150} lineHeight={0.92} />
        <span class="subline">Refacciones diésel para motores de rango pesado</span>
      </h1>

      <p class="claim">
        ¡Encuentra las mejores marcas! Refacciones originales y con garantía para unidades de rango medio y
        pesado, transporte de carga y pasajeros.
      </p>

      <ul class="specs">
        <li><Icon name="check" /> ¡Especialistas en medias reparaciones, cabezas de cilindro y más!</li>
        <li><Icon name="truck" /> Envíos a toda la república</li>
      </ul>

      <div class="ctas">
        <a class="btn btn--primary" href={whatsappHref()} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Cotiza por WhatsApp
        </a>
        <a class="btn btn--chrome" href="#motores">
          Busca tu motor
          <Icon name="arrow" />
        </a>
      </div>
    </div>

    <div class="grille" aria-hidden="true">
      <img class="grille-art" src="/grille.svg" alt="" width="480" height="400" fetchpriority="high" decoding="async" />
      <div class="emblem">
        <Image src={logoDark} alt="" width={260} height={170} loading="eager" />
        <span class="emblem-values">{company.values.join(' · ')}</span>
      </div>
    </div>
  </div>

  <div class="bumper">
    <div class="wrap">
      <h2 class="visually-hidden">Marcas con las que trabajamos</h2>
      <ul class="brand-row">
        {heroBrands.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 75% 10%, #0d4256 0%, transparent 60%),
      linear-gradient(180deg, var(--cab) 0%, var(--cab-deep) 100%);
    color: var(--white);
    isolation: isolate;
  }

  /* Five amber clearance lights on the cab roof. */
  .lights {
    display: flex;
    justify-content: center;
    gap: clamp(1.25rem, 5vw, 4.5rem);
    padding-block: 1.6rem 0.5rem;
  }
  .light {
    width: clamp(2.2rem, 4vw, 3.4rem);
    height: clamp(0.8rem, 1.3vw, 1.1rem);
    border-radius: 999px;
    background: radial-gradient(60% 90% at 50% 35%, var(--amber-hot), var(--amber) 55%, #b86d00 100%);
    box-shadow:
      0 0 0 2px #2b3a40,
      0 0 0 3px rgb(255 255 255 / 0.25),
      0 0 18px 4px rgb(255 178 46 / 0.55),
      0 6px 40px 10px rgb(255 178 46 / 0.25);
    animation: ignite 900ms var(--ease-out) both;
    animation-delay: calc(180ms + var(--i) * 110ms);
  }
  @keyframes ignite {
    0% {
      filter: brightness(0.25) saturate(0.4);
      box-shadow: 0 0 0 2px #2b3a40, 0 0 0 3px rgb(255 255 255 / 0.15);
    }
    35% {
      filter: brightness(1.6);
    }
    100% {
      filter: brightness(1);
    }
  }

  .cab {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--space-l);
    padding-block: var(--space-l) var(--space-xl);
  }

  h1 {
    display: grid;
    gap: 1.1rem;
  }
  /* Chrome nameplate: SVG lettering; it brightens once the roof lights finish switching on. */
  h1 :global(.headline) {
    display: block;
    width: 100%;
    max-width: 44rem;
    height: auto;
    overflow: visible;
    /* Compositor-only entrance (opacity + transform): no repaint while it plays. */
    animation: nameplate 900ms var(--ease-out) 600ms both;
  }
  @keyframes nameplate {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .subline {
    display: block;
    max-width: 26ch;
    font-family: var(--font-label);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.04em;
    color: var(--red-bright);
  }

  .claim {
    max-width: 52ch;
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.5;
    color: #c9d6dc;
  }

  .specs {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--space-m);
  }
  .specs li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-family: var(--font-label);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.3;
    color: var(--white);
  }
  .specs :global(svg) {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    padding: 0.15rem;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: var(--space-l);
  }

  /* Radiator grille: chrome surround, vertical slats, emblem mounted on top. */
  .grille {
    position: relative;
    aspect-ratio: 6 / 5;
    width: 100%;
    max-width: 32rem;
    justify-self: end;
    border-radius: 26px;
    /* box-shadow instead of filter: drop-shadow — same look on this rounded shape, no filter pass. */
    box-shadow: 0 30px 50px -18px rgb(0 0 0 / 0.75);
  }
  /* The grille is a real <img> in the HTML (high fetch priority, preloaded) because it is the LCP element. */
  .grille-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 26px;
    object-fit: cover;
  }
  .emblem {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    width: 78%;
    padding: 1.2rem 1rem 1rem;
    transform: translate(-50%, -50%);
    border-radius: 10px;
    background: linear-gradient(180deg, #0b3647, var(--cab-deep));
    box-shadow:
      0 0 0 3px #c9d2d7,
      0 0 0 5px #5c6a71,
      0 18px 30px -12px rgb(0 0 0 / 0.85);
  }
  .emblem img {
    width: 100%;
    height: auto;
  }
  .emblem-values {
    font-family: var(--font-label);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--chrome-2);
  }

  /* Chrome bumper carrying the brands from the original banner. */
  .bumper {
    position: relative;
    background: var(--chrome-h);
    color: var(--cab-deep);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.8), inset 0 -3px 0 rgb(0 0 0 / 0.25);
  }
  /* Full-strength chrome lips above and below the lettered face of the bumper. */
  .bumper::before,
  .bumper::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 9px;
    background: var(--chrome-bar);
  }
  .bumper::before {
    top: 0;
  }
  .bumper::after {
    bottom: 0;
    transform: scaleY(-1);
  }
  .brand-row {
    position: relative;
    z-index: 1;
  }
  .brand-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.75rem;
    padding-block: 1.05rem;
  }
  .brand-row li {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.7);
  }

  @media (max-width: 900px) {
    .cab {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-l);
    }
    .grille {
      justify-self: stretch;
      max-width: none;
      aspect-ratio: auto;
      height: 10rem;
    }
    .grille-art {
      object-fit: cover;
    }
    .emblem {
      width: auto;
      height: 76%;
      grid-auto-flow: column;
      align-items: center;
      padding: 0.6rem 1.2rem;
    }
    .emblem img {
      width: auto;
      height: 100%;
    }
    .emblem-values {
      display: none;
    }
    .brand-row {
      justify-content: center;
    }
  }

  @media (max-width: 520px) {
    .ctas .btn {
      flex: 1 1 100%;
    }
    .grille {
      height: 7.5rem;
    }
    .lights {
      padding-block: 1.1rem 0;
    }
  }
</style>
