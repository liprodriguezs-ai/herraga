---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ChromeLetters from './ChromeLetters.astro';
import cabPhoto from '../assets/hero/cab-duotone.jpg';
import { heroBrands, whatsappHref } from '../data/site';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <!-- Cab from the original banner, tinted to the brand navy. Only a 560 px crop was usable, so it is
       softened on purpose; replace the file with the original truck photo for a sharper result. -->
  <Image
    class="backdrop"
    src={cabPhoto}
    alt=""
    widths={[720, 1080, 1440]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="lights" aria-hidden="true">
    {Array.from({ length: 5 }).map((_, i) => <span class="light" style={`--i:${i}`} />)}
  </div>

  <div class="wrap cab">
    <div class="copy">
      <h1 id="hero-title">
        <span class="visually-hidden">La fuerza detrás de tu motor:</span>
        <ChromeLetters class="headline" lines={['LA FUERZA DETRÁS', 'DE TU MOTOR']} width={1040} size={150} lineHeight={0.92} />
        <span class="subline">Refacciones diésel para motores de rango pesado</span>
      </h1>

      <p class="claim">
        ¡Encuentra las mejores marcas! Refacciones originales y con garantía para unidades de rango medio y
        pesado, transporte de carga y pasajeros.
      </p>

      <ul class="specs">
        <li><Icon name="check" /> ¡Especialistas en medias reparaciones, cabezas de cilindro y más!</li>
        <li><Icon name="truck" /> Envíos a toda la república</li>
      </ul>

      <div class="ctas">
        <a class="btn btn--primary" href={whatsappHref()} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Cotiza por WhatsApp
        </a>
        <a class="btn btn--chrome" href="#motores">
          Busca tu motor
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </div>

  <div class="bumper">
    <div class="wrap">
      <h2 class="visually-hidden">Marcas con las que trabajamos</h2>
      <ul class="brand-row">
        {heroBrands.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 75% 10%, #0d4256 0%, transparent 60%),
      linear-gradient(180deg, var(--cab) 0%, var(--cab-deep) 100%);
    color: var(--white);
    isolation: isolate;
  }

  /* Duotone cab photo weighted to the right, under a navy wash so the copy on the left stays readable. */
  .hero :global(.backdrop) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right 30%;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(4 29 39 / 0.92) 0%, rgb(4 29 39 / 0.7) 42%, rgb(4 29 39 / 0.15) 100%),
      linear-gradient(180deg, rgb(4 29 39 / 0) 55%, var(--cab-deep) 100%);
  }

  /* Five amber clearance lights on the cab roof. */
  .lights {
    display: flex;
    justify-content: center;
    gap: clamp(1.25rem, 5vw, 4.5rem);
    padding-block: 1.6rem 0.5rem;
  }
  .light {
    width: clamp(2.2rem, 4vw, 3.4rem);
    height: clamp(0.8rem, 1.3vw, 1.1rem);
    border-radius: 999px;
    background: radial-gradient(60% 90% at 50% 35%, var(--amber-hot), var(--amber) 55%, #b86d00 100%);
    box-shadow:
      0 0 0 2px #2b3a40,
      0 0 0 3px rgb(255 255 255 / 0.25),
      0 0 18px 4px rgb(255 178 46 / 0.55),
      0 6px 40px 10px rgb(255 178 46 / 0.25);
    animation: ignite 900ms var(--ease-out) both;
    animation-delay: calc(180ms + var(--i) * 110ms);
  }
  @keyframes ignite {
    0% {
      filter: brightness(0.25) saturate(0.4);
      box-shadow: 0 0 0 2px #2b3a40, 0 0 0 3px rgb(255 255 255 / 0.15);
    }
    35% {
      filter: brightness(1.6);
    }
    100% {
      filter: brightness(1);
    }
  }

  .cab {
    padding-block: var(--space-l) var(--space-xl);
  }
  .copy {
    max-width: 46rem;
  }

  h1 {
    display: grid;
    gap: 1.1rem;
  }
  /* Chrome nameplate: SVG lettering; it brightens once the roof lights finish switching on. */
  h1 :global(.headline) {
    display: block;
    width: 100%;
    max-width: 44rem;
    height: auto;
    overflow: visible;
    /* No entrance animation: the headline is part of the first paint (it can be the LCP element). */
  }
  .subline {
    display: block;
    max-width: 26ch;
    font-family: var(--font-label);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.04em;
    color: var(--red-bright);
  }

  .claim {
    max-width: 52ch;
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.5;
    color: #c9d6dc;
  }

  .specs {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--space-m);
  }
  .specs li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-family: var(--font-label);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.3;
    color: var(--white);
  }
  .specs :global(svg) {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    padding: 0.15rem;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: var(--space-l);
  }

  /* Chrome bumper carrying the brands from the original banner. */
  .bumper {
    position: relative;
    background: var(--chrome-h);
    color: var(--cab-deep);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.8), inset 0 -3px 0 rgb(0 0 0 / 0.25);
  }
  /* Full-strength chrome lips above and below the lettered face of the bumper. */
  .bumper::before,
  .bumper::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 9px;
    background: var(--chrome-bar);
  }
  .bumper::before {
    top: 0;
  }
  .bumper::after {
    bottom: 0;
    transform: scaleY(-1);
  }
  .brand-row {
    position: relative;
    z-index: 1;
  }
  .brand-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.75rem;
    padding-block: 1.05rem;
  }
  .brand-row li {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.7);
  }

  @media (max-width: 900px) {
    .cab {
      padding-bottom: var(--space-l);
    }
    /* Copy spans the full width on small screens, so the wash covers the photo evenly. */
    .hero::before {
      background:
        linear-gradient(180deg, rgb(4 29 39 / 0.55) 0%, rgb(4 29 39 / 0.85) 45%, var(--cab-deep) 100%);
    }
    .brand-row {
      justify-content: center;
    }
  }

  @media (max-width: 520px) {
    .ctas .btn {
      flex: 1 1 100%;
    }
    .lights {
      padding-block: 1.1rem 0;
    }
  }
</style>
