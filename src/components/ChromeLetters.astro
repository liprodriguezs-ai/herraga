---
// Chrome trim lettering rendered as SVG. The material is built from flat stacked layers only —
// cast shadow, dark outline, light top edge, horizon-band chrome fill and a diagonal sheen —
// so it rasterizes once and never runs per-pixel SVG filters (costly on Safari and while animating).
// Decorative only; callers keep the live text in the DOM.
interface Props {
  lines: string[];
  class?: string;
  /** viewBox width; tune so the longest line fills it. */
  width?: number;
  size?: number;
  lineHeight?: number;
  style?: string;
}
const { lines, class: className, style, width = 1000, size = 150, lineHeight = 0.9 } = Astro.props;
const uid = `cl${Math.abs([...lines.join('')].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7)).toString(36)}`;
const step = size * lineHeight;
const top = size * 0.98;
const height = Math.ceil(top + step * (lines.length - 1) + size * 0.14);
const rows = lines.map((l, i) => ({ text: l, y: top + i * step }));
---

<svg
  class={className}
  style={style}
  viewBox={`0 0 ${width} ${height}`}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-fill`} x1="0" y1="0" x2="0" y2={step} gradientUnits="userSpaceOnUse" spreadMethod="repeat">
      <stop offset="0" stop-color="#fdfeff" />
      <stop offset="0.18" stop-color="#d5dfe6" />
      <stop offset="0.44" stop-color="#f4f8fa" />
      <stop offset="0.5" stop-color="#57636c" />
      <stop offset="0.57" stop-color="#2e363d" />
      <stop offset="0.72" stop-color="#9d9283" />
      <stop offset="0.9" stop-color="#ebe6de" />
      <stop offset="1" stop-color="#fdfeff" />
    </linearGradient>
    <linearGradient id={`${uid}-sheen`} x1="0" y1="0" x2={width} y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0.14" stop-color="#ffffff" stop-opacity="0" />
      <stop offset="0.22" stop-color="#ffffff" stop-opacity="0.5" />
      <stop offset="0.28" stop-color="#ffffff" stop-opacity="0" />
      <stop offset="0.64" stop-color="#ffffff" stop-opacity="0" />
      <stop offset="0.68" stop-color="#ffffff" stop-opacity="0.32" />
      <stop offset="0.72" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
  </defs>
  <g
    font-family="'Big Shoulders Display Variable', 'Barlow Condensed', sans-serif"
    font-weight="900"
    font-size={size}
    letter-spacing="1"
  >
    <!-- Cast shadow: two offset copies instead of a blur filter. -->
    <g fill="#000" fill-opacity="0.32" stroke="#000" stroke-opacity="0.32" stroke-width={size * 0.08} stroke-linejoin="round">
      {rows.map((r) => <text x="4" y={r.y + size * 0.075}>{r.text}</text>)}
    </g>
    <!-- Dark outline. -->
    <g fill="#02151d" stroke="#02151d" stroke-width={size * 0.06} stroke-linejoin="round">
      {rows.map((r) => <text x="4" y={r.y}>{r.text}</text>)}
    </g>
    <!-- Polished top edge: a light copy nudged up, left visible as a bevel highlight. -->
    <g fill="#ffffff" fill-opacity="0.85">
      {rows.map((r) => <text x="4" y={r.y - size * 0.018}>{r.text}</text>)}
    </g>
    <!-- Chrome face. -->
    <g fill={`url(#${uid}-fill)`}>
      {rows.map((r) => <text x="4" y={r.y}>{r.text}</text>)}
    </g>
    <!-- Diagonal sheen across the face. -->
    <g fill={`url(#${uid}-sheen)`}>
      {rows.map((r) => <text x="4" y={r.y}>{r.text}</text>)}
    </g>
  </g>
</svg>
