---
// Accurate map of Mexico with the branch locations. Geometry comes from
// src/data/mexico-map.json, generated by scripts/build-map.mjs (Natural Earth, INEGI Lambert projection).
import map from '../data/mexico-map.json';

const byCity = Object.fromEntries(map.branches.map((b) => [b.city, b]));
const valley = ['Huehuetoca', 'Cuautitlán Izcalli', 'CDMX'].map((c) => byCity[c]);
const tijuana = byCity['Tijuana'];
const queretaro = byCity['Querétaro'];

// Valley of Mexico inset: the three branches sit ~20 km apart, so they get a magnified detail box
// placed over open Pacific water (x 26–386, y 404–632 is sea in this projection).
const inset = { x: 26, y: 404, w: 360, h: 228 };
const ZOOM = 13;
const centre = {
  x: valley.reduce((s, b) => s + b.x, 0) / valley.length,
  y: valley.reduce((s, b) => s + b.y, 0) / valley.length,
};
const anchor = { x: inset.x + 78, y: inset.y + 116 };
const zoomed = valley.map((b) => ({
  city: b.city,
  x: Math.round((anchor.x + (b.x - centre.x) * ZOOM) * 10) / 10,
  y: Math.round((anchor.y + (b.y - centre.y) * ZOOM) * 10) / 10,
}));
const zoomTransform = `translate(${anchor.x} ${anchor.y}) scale(${ZOOM}) translate(${-centre.x} ${-centre.y})`;
---

<figure class="map">
  <svg viewBox={map.viewBox} role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">Mapa de sucursales HERRAGA en México</title>
    <desc id="map-desc">Sucursales en Tijuana, Baja California; Querétaro; Huehuetoca y Cuautitlán Izcalli, Estado de México; y Ciudad de México.</desc>
    <defs>
      <clipPath id="map-clip"><rect width="1000" height="660" rx="0" /></clipPath>
      <clipPath id="inset-clip"><rect x="26" y="404" width="360" height="228" rx="10" /></clipPath>
      <radialGradient id="pin-glow">
        <stop offset="0" stop-color="#ffb22e" stop-opacity="0.55" />
        <stop offset="1" stop-color="#ffb22e" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g clip-path="url(#map-clip)">
      <path d={map.neighbours} class="neighbours" />
      <path d={map.mexico} class="mexico" />
    </g>

    <g class="pin">
      <circle cx={tijuana.x} cy={tijuana.y} r="26" fill="url(#pin-glow)" />
      <circle cx={tijuana.x} cy={tijuana.y} r="11" class="dot" />
      <text x={tijuana.x + 20} y={tijuana.y + 34} class="label">Tijuana</text>
    </g>

    <g class="pin">
      <circle cx={queretaro.x} cy={queretaro.y} r="26" fill="url(#pin-glow)" />
      <circle cx={queretaro.x} cy={queretaro.y} r="10" class="dot" />
      <text x={queretaro.x} y={queretaro.y - 24} class="label" text-anchor="middle">Querétaro</text>
    </g>

    <g class="pin">
      <circle cx={centre.x} cy={centre.y} r="30" fill="url(#pin-glow)" />
      {valley.map((b) => <circle cx={b.x} cy={b.y} r="6" class="dot" />)}
    </g>

    <path d={`M${centre.x - 10} ${centre.y + 8} L${inset.x + inset.w} ${inset.y}`} class="leader" />

    <g class="inset">
      <rect x={inset.x} y={inset.y} width={inset.w} height={inset.h} rx="10" class="inset-frame" />
      <g clip-path="url(#inset-clip)">
        <path d={map.mexico} transform={zoomTransform} class="mexico" vector-effect="non-scaling-stroke" />
      </g>
      <text x={inset.x + 4} y={inset.y - 12} class="sublabel">Valle de México</text>
      {zoomed.map((b) => (
        <g>
          <circle cx={b.x} cy={b.y} r="11" class="dot" />
          <text x={b.x + 20} y={b.y + 10} class="label label--sm">{b.city}</text>
        </g>
      ))}
    </g>
  </svg>
  <figcaption>Cobertura nacional con envíos a todo México desde 5 sucursales.</figcaption>
</figure>

<style>
  .map {
    margin: var(--space-m) 0 0;
    padding: 12px;
    border-radius: 14px;
    background: var(--cab-deep);
    box-shadow: 0 0 0 4px #c9d2d7, 0 0 0 6px #5c6a71, 0 30px 60px -30px rgb(4 29 39 / 0.8);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    background:
      radial-gradient(90% 70% at 40% 30%, #0b3a4c, transparent 70%),
      #062634;
  }
  .neighbours {
    fill: #08293a;
    stroke: #143f51;
    stroke-width: 1;
  }
  .mexico {
    fill: #1b6782;
    stroke: #8fb3c2;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .dot {
    fill: var(--red-bright);
    stroke: var(--white);
    stroke-width: 2.5;
  }
  .leader {
    stroke: var(--amber);
    stroke-width: 2;
    fill: none;
  }
  .label {
    font-family: var(--font-label);
    font-size: 36px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: var(--white);
    paint-order: stroke;
    stroke: #041d27;
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .label--sm {
    font-size: 29px;
    letter-spacing: 0.04em;
  }
  .inset-frame {
    fill: #062634;
    stroke: var(--amber);
    stroke-width: 2.5;
  }
  .leader {
    stroke-dasharray: 6 6;
  }
  .sublabel {
    font-family: var(--font-label);
    font-size: 27px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--amber);
    paint-order: stroke;
    stroke: #041d27;
    stroke-width: 4px;
  }
  figcaption {
    padding: 0.75rem 0.4rem 0.2rem;
    font-family: var(--font-label);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9fb0b8;
  }
</style>
