---
// Accurate map of Mexico with the branch locations. Geometry comes from
// src/data/mexico-map.json, generated by scripts/build-map.mjs (Natural Earth, INEGI Lambert projection).
// Same four markers as the original HERRAGA graphic: Tijuana, Querétaro, Edo. Méx. and CDMX.
import map from '../data/mexico-map.json';

const byCity = Object.fromEntries(map.branches.map((b) => [b.city, b]));
const tijuana = byCity['Tijuana'];
const queretaro = byCity['Querétaro'];
const cdmx = byCity['CDMX'];
// Cuautitlán Izcalli and Huehuetoca share one "Edo. Méx." marker, placed between the two.
const edomex = {
  x: (byCity['Cuautitlán Izcalli'].x + byCity['Huehuetoca'].x) / 2,
  y: (byCity['Cuautitlán Izcalli'].y + byCity['Huehuetoca'].y) / 2,
};

const pins = [
  { ...tijuana, label: 'Tijuana', lx: tijuana.x + 20, ly: tijuana.y + 34, anchor: 'start' },
  { ...queretaro, label: 'Querétaro', lx: queretaro.x - 18, ly: queretaro.y - 16, anchor: 'end' },
  { ...edomex, label: 'Edo. Méx.', lx: edomex.x + 18, ly: edomex.y - 8, anchor: 'start' },
  { ...cdmx, label: 'CDMX', lx: cdmx.x, ly: cdmx.y + 46, anchor: 'middle' },
];
---

<figure class="map">
  <svg viewBox={map.viewBox} role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">Mapa de sucursales HERRAGA en México</title>
    <desc id="map-desc">Sucursales en Tijuana, Baja California; Querétaro; Estado de México (Cuautitlán Izcalli y Huehuetoca); y Ciudad de México.</desc>
    <defs>
      <clipPath id="map-clip"><rect width="1000" height="660" /></clipPath>
      <radialGradient id="pin-glow">
        <stop offset="0" stop-color="#ffb22e" stop-opacity="0.55" />
        <stop offset="1" stop-color="#ffb22e" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g clip-path="url(#map-clip)">
      <path d={map.neighbours} class="neighbours" />
      <path d={map.mexico} class="mexico" />
    </g>

    {pins.map((p) => <circle cx={p.x} cy={p.y} r="26" fill="url(#pin-glow)" />)}
    {pins.map((p) => <circle cx={p.x} cy={p.y} r="8" class="dot" />)}
    {pins.map((p) => (
      <text x={p.lx} y={p.ly} class="label" text-anchor={p.anchor}>{p.label}</text>
    ))}
  </svg>
  <figcaption>Cobertura nacional con envíos a todo México desde 5 sucursales.</figcaption>
</figure>

<style>
  .map {
    margin: var(--space-m) 0 0;
    padding: 12px;
    border-radius: 14px;
    background: var(--cab-deep);
    box-shadow: 0 0 0 4px #c9d2d7, 0 0 0 6px #5c6a71, 0 30px 60px -30px rgb(4 29 39 / 0.8);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    background:
      radial-gradient(90% 70% at 40% 30%, #0b3a4c, transparent 70%),
      #062634;
  }
  .neighbours {
    fill: #08293a;
    stroke: #143f51;
    stroke-width: 1;
  }
  .mexico {
    fill: #1b6782;
    stroke: #8fb3c2;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .dot {
    fill: var(--red-bright);
    stroke: var(--white);
    stroke-width: 2.5;
  }
  .label {
    font-family: var(--font-label);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    fill: var(--white);
    paint-order: stroke;
    stroke: #041d27;
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  figcaption {
    padding: 0.75rem 0.4rem 0.2rem;
    font-family: var(--font-label);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9fb0b8;
  }
</style>
