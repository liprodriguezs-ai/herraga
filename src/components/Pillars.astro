---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Filete from './Filete.astro';
import { pillars, branches, whatsappHref, telHref, NATIONAL_PHONE, SERVICE_PHONE, formatPhone } from '../data/site';
import garantia from '../assets/sections/garantia.jpg';
import asesoria from '../assets/sections/asesoria.jpg';
import envios from '../assets/sections/envios.jpg';
import pagos from '../assets/sections/pagos.jpg';

const images = { garantia, asesoria, envios, pagos };

// Branch dial strip + contact bars under the shipping image (flyer layout). Hidden for now;
// set to true to show it again. While hidden, the shipping pillar keeps its regular call button.
const SHOW_SHIPPING_DIAL = false;

const pointIcons: Record<string, string> = {
  'Pago con tarjeta': 'card',
  'Transferencia bancaria': 'bank',
  'Link de pago': 'link',
  Efectivo: 'cash',
  'Cobertura nacional': 'pin',
  'Envíos seguros': 'shield',
  'Entregas rápidas': 'truck',
  Calidad: 'award',
  Confianza: 'check',
  Garantía: 'shield',
};
---

<section id="por-que" class="pillars" aria-labelledby="pillars-title">
  <div class="wrap">
    <header class="head">
      <h2 id="pillars-title" class="section-title">Refacciones diésel con respaldo</h2>
      <p class="section-lede">
        Vendemos refacciones originales y con garantía para unidades de rango medio y pesado, transporte de
        carga y pasajeros.
      </p>
    </header>

    <div class="rows">
      {pillars.map((p, i) => (
        <article class:list={['row', { flip: i % 2 === 1 }]} id={p.id}>
          <div class="media">
            <Image
              src={images[p.image]}
              alt={p.imageAlt}
              widths={[400, 640, 760, 960, 1280]}
              sizes="(max-width: 860px) calc(100vw - 3.5rem), (max-width: 1340px) 48vw, 640px"
              loading="lazy"
            />
          </div>
          <div class="text">
            <h3>{p.title}</h3>
            {p.lead && <p class="lead">{p.lead}</p>}
            <p class="body">{p.body}</p>
            {p.points.length > 0 && (
              <ul class="points">
                {p.points.map((pt) => (
                  <li>
                    <Icon name={pointIcons[pt] ?? 'check'} />
                    {pt}
                  </li>
                ))}
              </ul>
            )}
            {(p.id !== 'envios' || !SHOW_SHIPPING_DIAL) && (
              <div class="ctas">
                {p.cta.kind === 'whatsapp' ? (
                  <a class="btn btn--primary" href={whatsappHref()} target="_blank" rel="noopener">
                    <Icon name="whatsapp" />
                    {p.cta.label}
                  </a>
                ) : (
                  <a class="btn btn--ghost" href={telHref(NATIONAL_PHONE)}>
                    <Icon name="phone" />
                    {p.cta.label} {formatPhone(NATIONAL_PHONE)}
                  </a>
                )}
              </div>
            )}
          </div>
          {SHOW_SHIPPING_DIAL && p.id === 'envios' && (
            <div class="dial">
              <h4 class="dial-title">Nuestras sucursales</h4>
              <ul class="dial-list">
                {branches.map((b) => (
                  <li>
                    <a href={telHref(b.phone)} aria-label={`Llamar a sucursal ${b.city}, ${formatPhone(b.phone)}`}>
                      <span class="dial-icon" aria-hidden="true"><Icon name="store" /></span>
                      <span class="dial-city">{b.city}<span>, {b.region}</span></span>
                      <span class="dial-num"><Icon name="phone" />{formatPhone(b.phone)}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <div class="dial-bars">
                <a class="bar bar--red" href={whatsappHref()} target="_blank" rel="noopener">
                  <Icon name="whatsapp" />
                  <span>
                    <span class="bar-label">Atención nacional</span>
                    <span class="bar-num">{formatPhone(NATIONAL_PHONE)}</span>
                  </span>
                </a>
                <a class="bar bar--black" href={telHref(SERVICE_PHONE)}>
                  <Icon name="headset" />
                  <span>
                    <span class="bar-label">Servicio a clientes</span>
                    <span class="bar-num">{formatPhone(SERVICE_PHONE)}</span>
                  </span>
                </a>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<div class="wrap divider"><Filete /></div>

<style>
  .pillars {
    padding-block: var(--space-xl) var(--space-l);
    background: var(--paint);
  }
  .head {
    max-width: 56rem;
  }

  .rows {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: var(--space-l);
  }
  .row.flip .media {
    order: 2;
  }

  .media {
    position: relative;
    border-radius: 10px;
    padding: 10px;
    background: var(--chrome-h);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), var(--shadow-lift), 0 30px 50px -30px rgb(4 29 39 / 0.55);
  }
  .media img {
    width: 100%;
    border-radius: 5px;
  }

  .text {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Shipping pillar footer: branch dial strip + contact bars, laid out like HERRAGA's shipping flyer. */
  .dial {
    grid-column: 1 / -1;
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 14px;
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--paint-2), 0 20px 40px -28px rgb(4 29 39 / 0.5);
  }
  .dial-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
    color: var(--cab);
  }
  .dial-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .dial-list li + li {
    border-left: 1px solid var(--paint-2);
  }
  .dial-list a {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.35rem;
    height: 100%;
    padding: 0.6rem 0.5rem 0.75rem;
    border-radius: 10px;
    color: var(--cab);
    text-align: center;
    text-decoration: none;
    transition: background-color 160ms;
  }
  .dial-list a:hover,
  .dial-list a:focus-visible {
    background: var(--paint);
  }
  .dial-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
  }
  .dial-icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  .dial-city {
    font-family: var(--font-label);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.15;
    text-transform: uppercase;
  }
  .dial-city span {
    color: var(--ink-soft);
  }
  .dial-num {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-label);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--red);
  }
  .dial-num :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .dial-bars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    color: var(--white);
    text-decoration: none;
    transition:
      filter 160ms,
      transform 160ms var(--ease-out);
  }
  .bar:hover,
  .bar:focus-visible {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }
  .bar--red {
    background: var(--red);
  }
  .bar--black {
    background: #0b0f12;
  }
  .bar :global(svg) {
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
  }
  .bar > span {
    display: grid;
    padding-left: 1rem;
    border-left: 2px solid rgb(255 255 255 / 0.5);
  }
  .bar-label {
    font-family: var(--font-label);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .bar-num {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
  }
  @media (max-width: 960px) {
    .dial-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 0.5rem;
    }
    .dial-list li + li {
      border-left: 0;
    }
  }
  @media (max-width: 640px) {
    .dial {
      padding: 1rem 0.75rem;
    }
    .dial-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .dial-bars {
      grid-template-columns: 1fr;
    }
  }

  h3 {
    font-size: var(--step-3);
    color: var(--cab);
  }
  .lead {
    font-family: var(--font-label);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--red);
  }
  .body {
    max-width: 52ch;
    color: var(--ink-soft);
  }
  .points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0.25rem 0.5rem;
  }
  .points li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem 0.45rem 0.6rem;
    border-radius: 999px;
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--paint-2), 0 2px 6px -3px rgb(4 29 39 / 0.25);
    font-family: var(--font-label);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--cab);
  }
  .points :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--red);
  }

  .divider {
    padding-block: var(--space-m);
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
    }
    .row.flip .media {
      order: 0;
    }
  }
</style>
