---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ChromeLetters from './ChromeLetters.astro';
import { engineBrands, partBrands } from '../data/site';

// Logos cropped from HERRAGA's own catalog slide (_source/img/cat-sitio-web.jpg) and, for IPD, the hero banner.
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/brands/*.png', { eager: true });
const slug = (name: string) =>
  name.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
const withLogo = (names: string[]) =>
  names.map((name) => ({ name, logo: logos[`../assets/brands/${slug(name)}.png`]?.default }));

const groups = [
  { title: 'Refacciones para motores', brands: withLogo(engineBrands) },
  { title: 'Nuestras marcas', brands: withLogo(partBrands) },
];
---

<section id="marcas" class="brands" aria-labelledby="marcas-title">
  <div class="wrap">
    <h2 id="marcas-title" class="section-title">
      <span class="visually-hidden">Las mejores marcas</span>
      <ChromeLetters class="title-art" lines={['LAS MEJORES MARCAS']} width={1290} size={150} style="--title-art-max: 52rem" />
    </h2>

    <div class="groups">
      {groups.map((g) => (
        <div class="group">
          <h3>{g.title}</h3>
          <ul class="plates">
            {g.brands.map((b) => (
              <li class="plate">
                <span class="face">
                  {b.logo ? (
                    <Image src={b.logo} alt={`Logo de ${b.name}`} height={72} densities={[1, 2]} loading="lazy" />
                  ) : (
                    <span class="fallback">{b.name}</span>
                  )}
                </span>
                <span class="name">{b.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .brands {
    padding-block: var(--space-xl);
    color: var(--white);
    background:
      radial-gradient(90% 60% at 85% 100%, #0d4256, transparent 70%),
      var(--cab);
  }

  /* Each group spans the full width so a whole brand family fits on one row at desktop size. */
  .groups {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-l);
  }
  h3 {
    margin-bottom: 1.2rem;
    font-family: var(--font-label);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--amber);
  }

  .plates {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 1.1rem 0.9rem;
  }
  /* Enamel badge: white face, polished chrome bezel, name stamped underneath. */
  .plate {
    display: grid;
    gap: 0.55rem;
    justify-items: center;
  }
  .face {
    display: grid;
    place-items: center;
    width: 100%;
    height: 6.5rem;
    padding: 0.8rem 1rem;
    border-radius: 10px;
    background: var(--white);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.08),
      0 0 0 4px #d6dde2,
      0 0 0 6px #6d7983,
      0 14px 22px -12px rgb(0 0 0 / 0.9);
    transition: transform 220ms var(--ease-out);
  }
  .plate:hover .face {
    transform: translateY(-3px);
  }
  .face img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 4.5rem;
    object-fit: contain;
  }
  .fallback {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--cab);
  }
  .name {
    margin-top: 0.35rem;
    font-family: var(--font-label);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chrome-2);
  }

  @media (max-width: 420px) {
    .plates {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
