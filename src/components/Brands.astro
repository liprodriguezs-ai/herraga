---
import { engineBrands, partBrands } from '../data/site';
---

<section id="marcas" class="brands" aria-labelledby="marcas-title">
  <div class="wrap">
    <h2 id="marcas-title" class="section-title chrome">Las mejores marcas</h2>

    <div class="groups">
      <div class="group">
        <h3>Refacciones para motores</h3>
        <ul class="emblems">
          {engineBrands.map((b) => <li class="emblem"><span>{b}</span></li>)}
        </ul>
      </div>
      <div class="group">
        <h3>Nuestras marcas</h3>
        <ul class="emblems">
          {partBrands.map((b) => <li class="emblem emblem--part"><span>{b}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .brands {
    padding-block: var(--space-xl);
    color: var(--white);
    background:
      radial-gradient(90% 60% at 85% 100%, #0d4256, transparent 70%),
      var(--cab);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l);
    margin-top: var(--space-l);
  }
  h3 {
    margin-bottom: 1.2rem;
    font-family: var(--font-label);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--amber);
  }

  .emblems {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  /* Bolt-on chrome emblem: polished bezel, enamel centre, debossed name. */
  .emblem {
    padding: 4px;
    border-radius: 10px;
    background: var(--chrome-h);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), 0 12px 20px -12px rgb(0 0 0 / 0.9);
    transition: transform 220ms var(--ease-out);
  }
  .emblem:hover {
    transform: translateY(-3px) rotate(-1deg);
  }
  .emblem span {
    display: block;
    padding: 0.7rem 1.2rem 0.6rem;
    border-radius: 7px;
    background: linear-gradient(180deg, #0b3647, var(--cab-deep));
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 2rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--white);
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.6);
  }
  .emblem--part span {
    background: linear-gradient(180deg, #d01625, var(--red-deep));
  }

  @media (max-width: 860px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }
</style>
