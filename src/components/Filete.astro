---
// Hand-painted pinstripe (filete) with a centre scroll, as painted along a cab side.
interface Props {
  tone?: 'red' | 'chrome' | 'amber';
}
const { tone = 'red' } = Astro.props;
---

<div class:list={['filete-wrap', `tone-${tone}`]} aria-hidden="true">
  <span class="line"></span>
  <svg viewBox="0 0 120 24" width="120" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M2 12h26c8 0 10-8 18-8 6 0 8 5 4 7-3 1.5-5-1-3-2.5" />
    <path d="M118 12H92c-8 0-10 8-18 8-6 0-8-5-4-7 3-1.5 5 1 3 2.5" />
    <path d="M52 12c3-4 13-4 16 0-3 4-13 4-16 0Z" />
  </svg>
  <span class="line"></span>
</div>

<style>
  .filete-wrap {
    display: flex;
    align-items: center;
    gap: 0;
    width: 100%;
  }
  .line {
    flex: 1;
    height: 6px;
    border-block: 2px solid currentColor;
    opacity: 0.9;
  }
  svg {
    flex: none;
    width: 7.5rem;
    height: auto;
  }
  .tone-red {
    color: var(--red);
  }
  .tone-chrome {
    color: var(--chrome-5);
  }
  .tone-amber {
    color: var(--amber);
  }
</style>
